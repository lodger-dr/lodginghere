# Supabase Public & Client Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Server-Only Secret (Never expose to client or commit to git)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Application Base URL (Canonical URL for authentication callbacks, emails, sitemaps and SEO)
NEXT_PUBLIC_APP_URL=https://lodginghere.vercel.app

# TomTom Orbis Maps API Key (Server & Client Raster Map Tiles & Geocoding)
TOM_TOM_API_KEY=your_tomtom_api_key_here
NEXT_PUBLIC_TOMTOM_API_KEY=your_tomtom_api_key_here
